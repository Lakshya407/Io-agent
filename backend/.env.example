# Application
APP_NAME=AI Agent Platform
APP_ENV=development
DEBUG=true

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT / Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default admin (created on first run, remove in production)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me-now
DEFAULT_ADMIN_NAME=Admin

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# LLM provider (local Ollama — see "LOCAL OLLAMA DEVELOPMENT" in README.md)
#
# Backend runs natively on the host:
#   OLLAMA_BASE_URL=http://localhost:11434
# Backend runs in Docker (docker compose) while Ollama runs on the host:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
# (a container's localhost is NOT the host's localhost)
OLLAMA_BASE_URL=http://localhost:11434
# Model used when a request does not name one. Must be a model you have
# pulled locally. On CPU-only machines the smaller llama3.2:1b is much faster
# than llama3.2 (3B): ollama pull llama3.2:1b
OLLAMA_DEFAULT_MODEL=qwen2.5:0.5b
# Extra models (comma separated) registered in the catalog so they appear in
# the chat UI dropdown. Each must be pulled locally first. Mind the memory
# budget: a model like phi3:mini holds ~3.6 GB in RAM and can starve the
# database on a small host.
OLLAMA_MODELS=phi3:mini,tinyllama
OLLAMA_REQUEST_TIMEOUT=180
# Keep the model in memory between requests (avoids the reload penalty after
# Ollama's idle unload). Set to 0 to unload after every request.
OLLAMA_KEEP_ALIVE=30m
