# Frontend environment variables.
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# Only variables prefixed with VITE_ are exposed to the browser by Vite.
# NEVER place secrets here (database passwords, JWT secrets, Redis
# credentials, provider keys) — anything committed here is public.
#
# Development: absolute URL to the local FastAPI server.
# Production (Docker/Nginx): a relative path is served by Nginx as a
# reverse proxy to the backend, so the browser and API share an origin
# and no CORS configuration is required.
VITE_API_BASE_URL=http://localhost:8000/api/v1
