# Full-stack environment overrides (docker compose).
#
# Copy to `.env` next to this file and adjust as needed. Only non-secret
# defaults are provided here; override the backend secrets for any real
# deployment.

# Port the frontend (Nginx) is published on.
FRONTEND_PORT=80

# PostgreSQL password (used by both postgres and backend services).
POSTGRES_PASSWORD=postgres

# Origins allowed by the backend CORS policy. In production the browser and
# the API share one origin through the Nginx proxy, so cross-origin requests
# are not normally made.
CORS_ORIGINS=http://localhost

# Ollama runs on the host (not as a container). The backend container reaches
# it through host.docker.internal; if you run the backend natively instead,
# use http://localhost:11434 (see backend/README.md).
OLLAMA_BASE_URL=http://host.docker.internal:11434
